# Port HTTP
PORT=3000
# URL publique (utilisée dans les e-mails, le widget et le flux iCal)
APP_URL=https://reservation.votre-domaine.com
# Fuseau horaire des salons
APP_TZ=Europe/Zurich
# Devise affichée
CURRENCY=CHF
# Secret de signature des sessions (32+ caractères aléatoires). Généré automatiquement dans data/secret sinon.
SESSION_SECRET=
# Compte administrateur de la plateforme (créé au premier démarrage)
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_PASSWORD=
# Paiements Stripe (vide = mode démonstration, rien n'est encaissé)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_COUNTRY=CH
# E-mails et SMS (Brevo)
BREVO_API_KEY=
MAIL_FROM=rendez-vous@votre-domaine.ch
MAIL_FROM_NAME=Lumea
SMS_SENDER=Lumea
SMS_DEFAULT_COUNTRY=41
# Webhook qui reçoit aussi chaque notification (Make, Zapier, n8n…)
NOTIFY_WEBHOOK_URL=
# Chemin de la base SQLite
DB_PATH=./data/lumea.db
# 0 = ne pas charger les salons de démonstration sur une base vide
SEED_DEMO=1
NODE_ENV=production

# Frais plateforme sur les paiements en ligne (acomptes, cartes cadeaux), en %. 0 = « zéro commission ».
PLATFORM_FEE_PERCENT=0
# Création de site sur mesure (CHF, une fois) et mise en avant sur la page d'accueil (CHF / mois)
CUSTOM_SITE_PRICE=250
BOOST_PRICE=29

# Connexion « Continuer avec Google » (console.cloud.google.com › Identifiants › ID client OAuth, type Web)
# URI de redirection autorisée : https://VOTRE-DOMAINE/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Connexion « Continuer avec Apple » (developer.apple.com › Identifiers › Services ID + clé Sign in with Apple)
# Return URL : https://VOTRE-DOMAINE/api/auth/oauth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Assistant IA (standard téléphonique + chat du site) — clé API Claude : console.anthropic.com
ANTHROPIC_API_KEY=
# Modèle utilisé (par défaut claude-opus-5-5)
AI_MODEL=
# Téléphonie (Twilio) : le jeton signe chaque requête de Twilio, il est vérifié par le serveur.
# Webhook du numéro (« A call comes in », POST) : https://VOTRE-DOMAINE/api/voice/incoming
TWILIO_AUTH_TOKEN=
TWILIO_VOICE=Polly.Lea-Neural
TWILIO_LANGUAGE=fr-FR
TWILIO_SPEECH_LANGUAGE=fr-CH

# Connexion des boîtes mail (lecture seule)
# Gmail : même client OAuth Google que ci-dessus + API Gmail activée. URI de redirection : https://VOTRE-DOMAINE/api/mail/callback/gmail
#   Le scope gmail.readonly est « restreint » : au-delà de 100 utilisateurs test, Google exige une vérification de sécurité (audit payant).
# Outlook : portal.azure.com › Inscriptions d'applications (comptes personnels + professionnels), permission Mail.Read.
#   URI de redirection : https://VOTRE-DOMAINE/api/mail/callback/outlook
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Clé de chiffrement des jetons de messagerie (par défaut dérivée de SESSION_SECRET — ne la changez plus ensuite)
MAIL_TOKEN_KEY=
