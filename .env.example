# Port HTTP
PORT=3000
# URL publique (utilisée dans les e-mails, le widget et le flux iCal)
APP_URL=https://reservation.votre-domaine.com
# Fuseau horaire des salons
APP_TZ=Europe/Zurich
# Devise affichée
CURRENCY=CHF
# Secret de signature des sessions (32+ caractères aléatoires). Généré automatiquement dans data/secret sinon.
SESSION_SECRET=
# Compte administrateur de la plateforme (créé au premier démarrage)
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_PASSWORD=
# Paiements Stripe (vide = mode démonstration, rien n'est encaissé)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_COUNTRY=CH
# E-mails et SMS (Brevo)
BREVO_API_KEY=
MAIL_FROM=rendez-vous@votre-domaine.ch
MAIL_FROM_NAME=Lumea
SMS_SENDER=Lumea
SMS_DEFAULT_COUNTRY=41
# Webhook qui reçoit aussi chaque notification (Make, Zapier, n8n…)
NOTIFY_WEBHOOK_URL=
# Chemin de la base SQLite
DB_PATH=./data/lumea.db
# 0 = ne pas charger les salons de démonstration sur une base vide
SEED_DEMO=1
NODE_ENV=production

# Frais plateforme sur les paiements en ligne (acomptes, cartes cadeaux), en %. 0 = « zéro commission ».
PLATFORM_FEE_PERCENT=0
# Création de site sur mesure (CHF, une fois) et mise en avant sur la page d'accueil (CHF / mois)
CUSTOM_SITE_PRICE=250
BOOST_PRICE=29
